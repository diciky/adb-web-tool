// ============================================================
// AdbProtocol.swift 修复补丁（真机测试发现，2026-11-20）
// 设备：Sony BRAVIA 4K UR3 (Android 9) + Amazon Fire TV AFTKA (Android 9)
// ============================================================
//
// 【Bug 1 · 核心】receiveSyncPacket 按「8 字节头(id+len)」解析所有 sync 响应，
//   但 Android adbd 的实际响应格式是：
//     DENT: id(4) + mode(4) + size(4) + mtime(4) + namelen(4) + name —— 无 length 字段！
//     DONE: 仅 id(4) —— 无 length 字段！
//     OKAY: 仅 id(4) —— 无 length 字段！
//     FAIL: id(4) + len(4) + msg
//     DATA: id(4) + len(4) + data
//   现有实现把 DENT 的 mode 字段误读为 length（如 0x41f9=16889B）→ 死等不存在的
//   数据 → 超时 → syncListBrokenHosts 误判「设备 adbd 怪癖」。
//   实测修正后两台电视 sync LIST 均 0.1s 返回（Sony 71 项 / FireTV 42 项），
//   shell 兜底（6.2s）可完全废弃。
//
// 【Bug 2】push 的 DONE 包：官方格式是「时间戳放在 4 字节 length 字段、无 body」。
//   现有实现发 body（header len=4 + 4 字节 body）→ adbd 把 body 当作下一个 sync
//   包的垃圾 id → 不回 ACK → 卡死/超时。Fire TV 与 Sony 实测均复现。
//   QUIT 同理应为单帧无 body、且不等 ACK（adbd 收到即关闭）。
//
// ---- 替换 receiveSyncPacket ----
private func receiveSyncPacket(local: UInt32, remote: UInt32) throws -> (String, Data)? {
    func readBytes(_ n: Int) throws -> Data {
        var out = Data()
        while out.count < n {
            let msg = try readFrame(local: local, remote: remote, expected: [AdbCmd.wrte, AdbCmd.clse, AdbCmd.fail])
            if msg.command == AdbCmd.wrte {
                try socket.sendMessage(AdbMessage(command: AdbCmd.okay, arg0: local, arg1: remote, data: Data()))
                out.append(msg.data)
            } else if msg.command == AdbCmd.clse {
                try? socket.sendMessage(AdbMessage(command: AdbCmd.clse, arg0: local, arg1: remote, data: Data()))
                return Data()   // EOF 标记：由调用方判断
            } else {
                throw AdbError.commandFailed(String(data: msg.data, encoding: .utf8) ?? "sync 命令失败")
            }
        }
        let r = out.prefix(n)
        syncBuffer = out.count > n ? Data(out.dropFirst(n)) : Data()   // 残留字节留给下一个包
        return Data(r)
    }
    // 4 字节 id（跨帧黏包安全；CLSE/EOF 时返回空）
    var idData = Data()
    while idData.count < 4 {
        let msg = try readFrame(local: local, remote: remote, expected: [AdbCmd.wrte, AdbCmd.clse, AdbCmd.fail])
        if msg.command == AdbCmd.wrte {
            try socket.sendMessage(AdbMessage(command: AdbCmd.okay, arg0: local, arg1: remote, data: Data()))
            idData.append(msg.data)
        } else if msg.command == AdbCmd.clse {
            try? socket.sendMessage(AdbMessage(command: AdbCmd.clse, arg0: local, arg1: remote, data: Data()))
            return nil
        } else {
            throw AdbError.commandFailed(String(data: msg.data, encoding: .utf8) ?? "sync 命令失败")
        }
    }
    let id = String(data: idData.prefix(4), encoding: .ascii) ?? ""
    // 残留（id 跨帧时 4 字节后的多余字节）
    var rest = idData.count > 4 ? Data(idData.dropFirst(4)) : Data()
    syncBuffer = rest

    switch id {
    case "DENT":
        // 无 length 字段：固定 16 字节 stat + namelen 字节 name
        var stat = rest
        if stat.count < 16 { stat.append(try readBytes(16 - stat.count)) }
        let mode = stat.u32le(0); let size = stat.u32le(4)
        let mtime = stat.u32le(8); let nlen = Int(stat.u32le(12))
        var body = stat.prefix(16)
        if nlen > 0 { body.append(try readBytes(nlen)) }
        Self.dentSeen += 1
        if Self.dentSeen <= 3 || Self.dentSeen % 50 == 0 { AdbLog.log("sync<DENT #\(Self.dentSeen) name_len=\(nlen)") }
        return (id, Data(body))
    case "DONE", "OKAY", "QUIT":
        AdbLog.log("sync<\(id)")
        return (id, Data())
    case "FAIL":
        let hdr = rest.count >= 4 ? rest.prefix(4) : (rest + try readBytes(4 - rest.count))
        let ln = Int(UInt32.fromLE(Array(hdr)))
        let msg = try readBytes(ln)
        AdbLog.log("sync<FAIL len=\(ln)")
        return (id, Data(msg))
    case "DATA":
        let hdr = rest.count >= 4 ? rest.prefix(4) : (rest + try readBytes(4 - rest.count))
        let ln = Int(UInt32.fromLE(Array(hdr)))
        let data = try readBytes(ln)
        AdbLog.log("sync<DATA len=\(ln)")
        return (id, Data(data))
    default:
        throw AdbError.protocolError("sync 未知响应包 \(id)")
    }
}
// 注意：syncBuffer 仍是字节流语义（readBytes 消费 n 字节、剩余保留），
// 但「8 字节头 + body」的旧解析必须整体删除 —— DENT/DONE/OKAY 没有 length 字段。

// ---- 替换 push 中的 DONE/QUIT（其余不变）----
// 旧：
//   try sendSyncFrame("DONE", body: Data(UInt32(Date().timeIntervalSince1970).leBytes), local: local, remote: remote)
// 新：
let doneFrame = Data("DONE".utf8) + Data(UInt32(Date().timeIntervalSince1970).leBytes)  // 时间戳在 length 字段位
try socket.sendMessage(AdbMessage(command: AdbCmd.wrte, arg0: local, arg1: remote, data: doneFrame))
_ = try readFrame(local: local, remote: remote, expected: [AdbCmd.okay], timeout: 15)   // 传输层 ACK
guard let (id, body) = try receiveSyncPacket(local: local, remote: remote) else {
    throw AdbError.protocolError("sync 通道提前关闭")
}
if id == "FAIL" { throw AdbError.commandFailed("推送失败：\(String(data: body, encoding: .utf8) ?? "未知错误")") }
guard id == "OKAY" else { throw AdbError.protocolError("sync 返回未知包 \(id)") }
// QUIT：单帧、不等 ACK
try? socket.sendMessage(AdbMessage(command: AdbCmd.wrte, arg0: local, arg1: remote, data: Data("QUIT".utf8) + Data(UInt32(0).leBytes)))
